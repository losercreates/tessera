# ==============================================================================
# Tessera Gateway Environment Configuration
# Copy this file to .env before starting the container stack with Docker Compose
# ==============================================================================

# Redis Stack Connection
REDIS_HOST=redis-stack
REDIS_PORT=6379

# Tessera Gateway Network Services
GATEWAY_PORT=50051
HTTP_PORT=8080
METRICS_PORT=9090
TESSERA_MOCK_UPSTREAMS=0

# Performance & Concurrency
WORKER_THREADS=8

# Cache Configuration
CACHE_TTL=86400
SIMILARITY_THRESHOLD=0.95

# ==============================================================================
# Upstream AI Provider Registry & Cascade Configuration
# ==============================================================================
# Tessera is fully provider-agnostic. Upstream platforms are NOT hardcoded.
# Groq, OpenRouter, DeepSeek, Ollama, vLLM, Together, and OpenAI are all optional.
#
# Primary Convention: Indexed Ordered Cascade (1 = Primary, 2 = Secondary, 3 = Tertiary...)
# Outages or HTTP 429 quota exhaustion on Provider 1 automatically fail over to Provider 2, etc.

# Upstream 1 (Local cluster - primary)
PROVIDER_1_NAME=ollama
PROVIDER_1_ENDPOINT=http://ollama-service:11434/v1/chat/completions
PROVIDER_1_MODEL=llama3.2
PROVIDER_1_SUPPORTED_MODELS=llama3.2,phi3
PROVIDER_1_RPM=120

# Upstream 2 (Fast cloud - secondary)
PROVIDER_2_NAME=groq
PROVIDER_2_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
PROVIDER_2_KEY=gsk_...
PROVIDER_2_MODEL=llama-3.1-8b-instant
PROVIDER_2_SUPPORTED_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile
PROVIDER_2_RPM=30
PROVIDER_2_RPD=1000
PROVIDER_2_FAILURE_THRESHOLD=3
PROVIDER_2_COOLDOWN_MS=1000

# Upstream 3 (Cloud fallback - tertiary)
PROVIDER_3_NAME=deepseek
PROVIDER_3_ENDPOINT=https://api.deepseek.com/v1/chat/completions
PROVIDER_3_KEY=sk-...
PROVIDER_3_MODEL=deepseek-chat
PROVIDER_3_RPM=60
PROVIDER_3_RPD=1000

# ------------------------------------------------------------------------------
# Alternative Convention: Named List (TESSERA_PROVIDERS=p1,p2,p3)
# ------------------------------------------------------------------------------
# TESSERA_PROVIDERS=ollama,groq,deepseek
# PROVIDER_OLLAMA_ENDPOINT=http://localhost:11434/v1/chat/completions
# PROVIDER_OLLAMA_MODEL=llama3.2
# PROVIDER_GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# PROVIDER_GROQ_KEY=gsk_...
# PROVIDER_GROQ_MODEL=llama-3.1-8b-instant

