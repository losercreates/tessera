# ==============================================================================
# Tessera Gateway Environment Configuration
# Copy this file to .env before starting the container stack with Docker Compose
# ==============================================================================

# Redis Stack Connection
REDIS_HOST=redis-stack
REDIS_PORT=6379

# Tessera Gateway Network Services
GATEWAY_PORT=50051
METRICS_PORT=9090

# Performance & Concurrency
WORKER_THREADS=8

# Cache Configuration
CACHE_TTL=86400
SIMILARITY_THRESHOLD=0.95

# LLM Upstream Provider Credentials (Optional: mock upstream is used if empty)
GROQ_API_KEY=
OPENROUTER_API_KEY=

